#!/bin/sh
# Blocks direct pushes to main. Changes reach main only through a reviewed
# pull request from a phase/* branch. Enabled with:
#   git config core.hooksPath .githooks

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are blocked." >&2
    echo "Open a pull request from your phase/* branch instead." >&2
    exit 1
  fi
done

exit 0
